# All tokens/keys are SERVER ONLY. Fill in Vercel Environment Variables and redeploy.
SUPABASE_SERVICE_ROLE_KEY=
CONTENT_ADMIN_USER_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_PROVIDER_ORDER=gemini,anthropic,openai
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Facebook Login flow: Page token with Instagram permissions. Optional fallback to FB Page token.
INSTAGRAM_ACCESS_TOKEN=
# Your public HTTPS production origin, required for any post with an image.
PUBLIC_SITE_URL=
# Optional separate secret for short-lived media signatures.
SOCIAL_IMAGE_SIGNING_SECRET=

# Optional image model; uses the same GEMINI_API_KEY. Image generation may be billed.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Instagram Login directly: use Instagram App ID/Secret from Instagram API setup.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: defaults to META_GRAPH_VERSION, then v26.0.
INSTAGRAM_GRAPH_VERSION=
# Optional separate encryption secret. If empty, tokens are encrypted using a key
# derived from INSTAGRAM_APP_SECRET. Changing the encryption key requires reconnect.
INSTAGRAM_TOKEN_ENCRYPTION_SECRET=

# OAuth Facebook Fanpage — Facebook App credentials from Basic Settings
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional: Login for Business configuration that issues USER access tokens
FACEBOOK_LOGIN_CONFIG_ID=
# OAuth Threads — use the Threads App ID/Secret, not Facebook/Instagram IDs
THREADS_APP_ID=
THREADS_APP_SECRET=
# Optional shared encryption secret (server only). If omitted, each platform
# derives its own encryption key from its App Secret. Rotation requires reconnect.
SOCIAL_TOKEN_ENCRYPTION_SECRET=
