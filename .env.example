# SERVER ONLY — enter these in Vercel Environment Variables. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# UUID of your existing Supabase Authentication user (not project ID)
CONTENT_ADMIN_USER_ID=
# AI: điền ít nhất một khóa. Mặc định thử Gemini (miễn phí) trước, lỗi/hết lượt thì chuyển Claude, rồi ChatGPT.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Thứ tự ưu tiên, bỏ bớt nhà nào bạn không muốn dùng
AI_PROVIDER_ORDER=gemini,anthropic,openai
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Use the supported Graph API version shown for your Meta app, e.g. v25.0
META_GRAPH_VERSION=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
